node_modules/
dist/
.expo/
coverage/
*.log
.DS_Store
.env
.env.local
sim-output/

# Raw source CSVs — re-fetch with data/raw/fetch.sh, never committed
data/raw/*.csv
data/raw/nfl/

# Supabase local stack
supabase/.temp/
supabase/.branches/

# Concept art — kept locally, not published
*.png
!apps/mobile/assets/*.png

# Local secrets, never committed
.local/

# Native projects are generated from app.config.js by `expo prebuild`, so they
# are build output rather than source. Committing them means the config and the
# native project can silently disagree; regenerating them takes one command.
apps/mobile/ios/
apps/mobile/android/
