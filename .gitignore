node_modules/
dist/
.expo/
coverage/
*.log
.DS_Store
.env
.env.local
sim-output/

# Raw source CSVs — re-fetch with data/raw/fetch.sh, never committed
data/raw/*.csv
data/raw/nfl

# Hydrated pre-1999 source data: season files in the canonical shape
# `packages/data/src/seasons.ts` documents, and the standings and brackets
# `scripts/build-era-stories.py` reads. Never committed: these are built from
# whatever source you have a licence to read, and that licence does not travel
# with the repository. See docs/hydrating-seasons.md.
data/raw/seasons
data/raw/results

# Supabase local stack
supabase/.temp/
supabase/.branches/

# Concept art — kept locally, not published
*.png
!apps/mobile/assets/*.png
# The brand artwork every launcher icon is generated from, and the images the
# README needs. Without the first one, `scripts/make-icons.py` refers to a file
# a fresh clone does not have.
!apps/mobile/assets/brand/*.png
!docs/media/*.png
# Store assets. They are generated, but from the *deployed* site rather than
# from this checkout, so a fresh clone cannot rebuild them and a submission
# needs them on hand.
!apps/mobile/assets/store/*.png
!apps/mobile/assets/store/**/*.png
!docs/media/*.jpg
# The link preview card. It is served, not built, so a clone that does not have
# it deploys a page whose og:image 404s — which renders as a broken frame rather
# than falling back to no image at all.
!apps/mobile/public/*.png

# Local secrets, never committed
# No trailing slash, deliberately. Each of these is a directory in this
# checkout and a *symlink* inside an agent's worktree
# (scripts/agent-worktree.sh), and a trailing slash matches a directory but not
# a link -- with one, `git add -A` in a worktree offers to commit a symlink
# pointing at this machine's credentials. The bare form matches both.
.local

# Native projects are generated from app.config.js by `expo prebuild`, so they
# are build output rather than source. Committing them means the config and the
# native project can silently disagree; regenerating them takes one command.
apps/mobile/ios/
apps/mobile/android/
.vercel
