{
  "name": "@18-0/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/sim/cli/reachability.ts",
    "calibrate": "tsx src/sim/cli/calibrate.ts",
    "regen:fixtures": "tsx src/sim/cli/regen-fixtures.ts",
    "build:edge": "esbuild src/index.ts --bundle '--banner:js=// GENERATED by: pnpm --filter @18-0/domain build:edge -- do not hand-edit.' --format=esm --platform=neutral --target=es2022 --outfile=../../supabase/functions/_shared/domain.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.0"
  }
}
